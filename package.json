{
  "name": "bothalla",
  "version": "1.0.0",
  "private": true,
  "description": "Bot de Discord para consultar Brawlhalla API v1.0",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node build/index.js",
    "dev": "nodemon --watch src --ext ts,json --exec tsx src/index.ts",
    "deploy:commands": "tsx src/scripts/deploy-commands.ts",
    "emojis:upload": "tsx src/scripts/upload-emojis.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3",
    "mongodb": "^7.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
